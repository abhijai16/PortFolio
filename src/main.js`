/* ---- Ghost Cursors Interaction ---- */
(function initGhostCursors() {
    const container = getElementById('projects');
    const ghosts = GHOSTS.map(([name, color], i) => {
        const element = document.createElement('div');
        element.className = 'gh';
        element.innerHTML = `
            <svg width="14" height="16" viewBox="0 0 18 20">
                <path d="M1 1l14 8-6 2-3 7z" fill="${color}"/>
            </svg>
            <i style="background:${color}; box-shadow:0 0 14px ${color}">${name}</i>
        `;
        container.appendChild(element);

        // Define anchor points for drift
        const anchors = [
            [0.03, 0.1], [0.82, 0.18], [0.02, 0.42],
            [0.84, 0.55], [0.03, 0.72], [0.8, 0.8]
        ];
        const anchor = anchors[i % 6];
        const startX = container.clientWidth * anchor[0];
        const startY = container.clientHeight * anchor[1];

        return {
            element,
            x: startX,
            y: startY,
            anchorX: startX,
            anchorY: startY,
            targetX: startX,
            targetY: startY,
            velocity: getRandomRange(10, 18)
        };
    });

    let lastTimestamp = performance.now();

    function animate(now) {
        const rect = container.getBoundingClientRect();
        if (prefersReducedMotion || rect.bottom < 0 || rect.top > window.innerHeight) {
            lastTimestamp = now;
            requestAnimationFrame(animate);
            return;
        }

        const deltaTime = Math.min(0.05, (now - lastTimestamp) / 1000);
        lastTimestamp = now;

        ghosts.forEach(ghost => {
            const dx = ghost.targetX - ghost.x;
            const dy = ghost.targetY - ghost.y;
            const distance = Math.hypot(dx, dy);

            if (distance < 4) {
                // Pick a new target near the anchor
                ghost.targetX = ghost.anchorX + getRandomRange(-40, 40);
                ghost.targetY = ghost.anchorY + getRandomRange(-40, 40);
            } else {
                ghost.x += (dx / distance) * ghost.velocity * deltaTime;
                ghost.y += (dy / distance) * ghost.velocity * deltaTime;
            }

            ghost.element.style.transform = `translate(${ghost.x}px, ${ghost.y}px)`;
        });

        requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);
})();

/* ---- Footer Accordion & Contact Form ---- */
CRED.forEach(([title, description]) => {
    const row = document.createElement('div');
    row.className = 'row';
    row.innerHTML = `
        <button aria-expanded="false">
            <span>+&nbsp;&nbsp;${title}</span>
            <span>⌄</span>
        </button>
        <div>${description}</div>
    `;

    row.firstChild.onclick = () => {
        const isOpen = row.classList.contains('on');

        // Close all other rows
        document.querySelectorAll('.row').forEach(item => {
            item.classList.remove('on');
            item.firstChild.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
            row.classList.add('on');
            row.firstChild.setAttribute('aria-expanded', 'true');
        }
    };
    getElementById('ac').appendChild(row);
});

