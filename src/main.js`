/* ---- Storybook Interaction ---- */
let currentPageIndex = -1;

function updateBook(shouldAnimate) {
    const oldRightContent = shouldAnimate && !getElementById('bk').hidden ? getElementById('pr').innerHTML : null;

    // Left Page: Index
    const leftPage = getElementById('pl');
    leftPage.innerHTML = '<h4>INDEX</h4>' + CHAPTERS.map((chapter, i) =>
        `<button class="idx ${i == currentPageIndex ? 'on' : ''}" data-i="${i}">
            ${String(i + 1).padStart(2, '0')}. ${chapter[0]}
            <small>p. 0${i + 1}</small>
        </button>`
    ).join('');

    // Right Page
    const rightPage = getElementById('pr');
    rightPage.className = 'pg r';
    const closeButton = '<button class="x" aria-label="Close book">×</button>';

    if (currentPageIndex < 0) {
        rightPage.innerHTML = closeButton + '<h4 style="margin-top:34px">Start reading</h4><p style="text-align:center;margin-top:30px">Pick a chapter from the index, or click this page to turn it.</p>';
    } else if (currentPageIndex >= CHAPTERS.length) {
        rightPage.innerHTML = closeButton + '<div class="end">The End<button id="again">↻ Read Again</button></div>';
    } else {
        rightPage.innerHTML = closeButton + `<h4 style="margin-top:34px">${CHAPTERS[currentPageIndex][0]}</h4><p>${CHAPTERS[currentPageIndex][1]}</p>`;
    }

    // Page turn animation
    if (oldRightContent !== null) {
        const leaf = document.createElement('div');
        leaf.className = 'leaf';
        leaf.innerHTML = `<div class="pg r lf">${oldRightContent}</div><div class="pg l lb"></div>`;
        getElementById('bk').appendChild(leaf);
        leaf.onanimationend = () => leaf.remove();
    }
}

getElementById('pl').onclick = (e) => {
    const btn = e.target.closest('.idx');
    if (btn) {
        currentPageIndex = +btn.dataset.i;
        updateBook(true);
    }
};

getElementById('pr').onclick = (e) => {
    if (e.target.closest('.x')) {
        currentPageIndex = -1;
        updateBook();
        getElementById('bk').hidden = true;
        getElementById('cv').hidden = false;
        return;
    }
    if (e.target.id == 'again') {
        currentPageIndex = -1;
    } else if (currentPageIndex < CHAPTERS.length) {
        currentPageIndex++;
    }
    updateBook(true);
};

getElementById('cv').onclick = () => {
    const cover = getElementById('cv');
    cover.classList.add('opening');
    setTimeout(() => {
        cover.hidden = true;
        cover.classList.remove('opening');
        getElementById('bk').hidden = false;
        updateBook();
    }, 450);
};

updateBook();

