/* ---- Scroll-linked SVG path animation ---- */
(function initPathAnimation() {
    const storySection = getElementById('story');
    const pathElement = getElementById('tp');

    const updatePath = () => {
        const rect = storySection.getBoundingClientRect();
        // Calculate dash offset based on section position
        const offset = 1 - Math.min(1, Math.max(0, (window.innerHeight * 0.35 - rect.top) / (rect.height * 0.45)));
        pathElement.style.strokeDashoffset = offset;
    };

    onScroll(updatePath);
    updatePath();
})();

/* ---- Projects heading: Typing effect with random chars ---- */
(function initProjectsTyping() {
    const element = getElementById('ph');
    const text = 'Projects';
    const alphabet = 'abcdefghijklmnopqrstuvwxyz';
    element.textContent = ' ';

    observeIntersection(element, () => {
        let index = 0;
        const timer = setInterval(() => {
            index++;
            element.textContent = text.slice(0, index) +
                (index < text.length ? alphabet[Math.random() * 26 | 0] : '') + '_';

            if (index >= text.length) {
                clearInterval(timer);
                setTimeout(() => {
                    element.textContent = text;
                }, 800);
            }
        }, 90);
    });
})();
