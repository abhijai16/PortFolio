// Set the accent color globally for CSS variables
document.documentElement.style.setProperty('--ac', ACC);

/**
 * Utility to run a function once on the next scroll event
 * using requestAnimationFrame for performance.
 */
const onScroll = (callback) => {
    let ticking = false;
    window.addEventListener('scroll', () => {
        if (!ticking) {
            ticking = true;
            requestAnimationFrame(() => {
                ticking = false;
                callback();
            });
        }
    }, { passive: true });
};

// Accessibility check for motion preference
const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---- Helpers ---- */
const getElementById = (id) => document.getElementById(id);
const getRandomRange = (min, max) => min + Math.random() * (max - min);

let mouseX = window.innerWidth / 2;
let mouseY = window.innerHeight / 2;
let cursorX = mouseX;
let cursorY = mouseY;

window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
});

// Smooth custom cursor animation
(function animateCursor() {
    cursorX += (mouseX - cursorX) * 0.25;
    cursorY += (mouseY - cursorY) * 0.25;
    const cursor = getElementById('cur');
    if (cursor) {
        cursor.style.transform = `translate(${cursorX}px, ${cursorY}px)`;
    }
    requestAnimationFrame(animateCursor);
})();

/**
 * Intersection Observer wrapper for triggering animations
 */
const observeIntersection = (element, callback) => {
    const observer = new IntersectionObserver((entries, observerInstance) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                callback(entry.target);
                observerInstance.unobserve(entry.target);
            }
        });
    }, { threshold: 0.3 });
    observer.observe(element);
};

/**
 * Simple typewriter effect
 */
function typeText(element, text, speed, callback) {
    let index = 0;
    function step() {
        element.textContent = text.slice(0, index++);
        if (index <= text.length) {
            setTimeout(step, speed);
        } else if (callback) {
            callback();
        }
    }
    step();
}

/* ---- Hero Section: Halftone Canvas Effect ---- */
(function initHeroCanvas() {
    const canvas = getElementById('hc');
    const ctx = canvas.getContext('2d');
    const gridSize = window.innerWidth < 700 ? 16 : 12;
    let width, height, time = 0;
    let lastMouseX = -999, lastMouseY = -999;

    const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = canvas.clientWidth;
        height = canvas.clientHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    resize();
    window.addEventListener('resize', resize);

    window.addEventListener('mousemove', (e) => {
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
    });

    function render() {
        // Stop rendering if motion is reduced, scrolled too far, or page is hidden
        if (prefersReducedMotion || window.scrollY > window.innerHeight * 3.4 || document.hidden) {
            requestAnimationFrame(render);
            return;
        }

        ctx.clearRect(0, 0, width, height);
        time += 0.012;

        for (let y = gridSize / 2; y < height; y += gridSize) {
            for (let x = gridSize / 2; x < width; x += gridSize) {
                // Complex wave function to create organic patterns
                let value = (
                    Math.sin(x * 0.011 + time) +
                    Math.sin(y * 0.015 - time * 0.8) +
                    Math.sin((x + y) * 0.008 + time * 0.5) +
                    Math.sin(Math.hypot(x - width / 2, y - height / 2) * 0.01 - time)
                ) / 8 + 0.5;

                // Interaction: increase value near mouse cursor
                const dist = Math.hypot(x - lastMouseX, y - lastMouseY);
                if (dist < 150) {
                    value = Math.min(1, value + (1 - dist / 150) * 0.4);
                }

                ctx.fillStyle = `rgba(${ACC}, ${0.25 + value * 0.75})`;

                if (value < 0.35) {
                    // Draw small dashes for low values
                    const size = 1 + gridSize * 0.3 * value / 0.35;
                    ctx.fillRect(x - size, y - 0.5, size * 2, 1);
                    ctx.fillRect(x - 0.5, y - size, 1, size * 2);
                } else if (value < 0.7) {
                    // Draw circles for medium values
                    ctx.beginPath();
                    ctx.arc(x, y, (value - 0.3) * gridSize * 0.9, 0, 6.283);
                    ctx.fill();
                } else {
                    // Draw squares for high values
                    const size = gridSize * (0.55 + 0.4 * value);
                    ctx.fillRect(x - size / 2, y - size / 2, size, size);
                }
            }
        }
        requestAnimationFrame(render);
    }
    render();
})();

/* ---- Intro Card: Scroll-Grow & Scramble ---- */
(function initIntroCard() {
    const section = getElementById('intro');
    const card = getElementById('ci');
    const hiText = getElementById('hi');
    const CHARS = '!<>-_\\/[]{}=+*^?#';
    const FINAL_TEXT = 'Hi!';
    let isBusy = false;

    function scramble() {
        if (isBusy) return;
        isBusy = true;
        let iteration = 0;

        const timer = setInterval(() => {
            hiText.textContent = [...FINAL_TEXT].map((char, index) => {
                return index < iteration / 4 ? char : CHARS[Math.random() * CHARS.length | 0];
            }).join('');

            if (++iteration > FINAL_TEXT.length * 4 + 2) {
                clearInterval(timer);
                hiText.textContent = FINAL_TEXT;
                isBusy = false;
            }
        }, 45);
    }

    const updateCardSize = () => {
        const rect = section.getBoundingClientRect();
        // Calculate growth based on scroll position relative to section height
        const progress = Math.min(1, Math.max(0, -rect.top / (rect.height - window.innerHeight)));
        const eased = progress * progress * (3 - 2 * progress);

        const targetWidth = Math.min(640, window.innerWidth * 0.9);
        const targetHeight = targetWidth * 0.5625;

        card.style.width = targetWidth + (window.innerWidth - targetWidth) * eased + 'px';
        card.style.height = targetHeight + (window.innerHeight - targetHeight) * eased + 'px';
        card.style.borderRadius = 16 * (1 - eased) + 'px';
    };

    onScroll(updateCardSize);
    window.addEventListener('resize', updateCardSize);
    updateCardSize();

    observeIntersection(card, scramble);
    card.addEventListener('mouseenter', scramble);

    // Occasional auto-scramble when in view
    setInterval(() => {
        const rect = card.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
            scramble();
        }
    }, 5000);
})();

/* ---- Tick Field Canvas ---- */
(function initTickField() {
    const canvas = getElementById('tc');
    const ctx = canvas.getContext('2d');
    const GRID_SIZE = 90;
    let width, height, angles = [];

    const resize = () => {
        width = canvas.width = canvas.clientWidth;
        height = canvas.height = canvas.clientHeight;
        angles = new Array(Math.ceil(width / GRID_SIZE) * Math.ceil(height / GRID_SIZE)).fill(0.8);
    };

    resize();
    window.addEventListener('resize', resize);

    function render() {
        const rect = canvas.getBoundingClientRect();
        const relativeMouseX = mouseX - rect.left;
        const relativeMouseY = mouseY - rect.top;

        if (prefersReducedMotion || rect.bottom < 0 || rect.top > window.innerHeight) {
            requestAnimationFrame(render);
            return;
        }

        ctx.clearRect(0, 0, width, height);
        ctx.strokeStyle = `rgba(${ACC}, 0.6)`;
        ctx.lineWidth = 2;

        let index = 0;
        for (let y = GRID_SIZE / 2; y < height; y += GRID_SIZE) {
            for (let x = GRID_SIZE / 2; x < width; x += GRID_SIZE, index++) {
                // Calculate angle towards mouse
                const targetAngle = Math.atan2(relativeMouseY - y, relativeMouseX - x);
                let diff = ((targetAngle - angles[index] + Math.PI * 3) % (Math.PI * 2)) - Math.PI;

                angles[index] += diff * 0.1;

                ctx.save();
                ctx.translate(x, y);
                ctx.rotate(angles[index]);
                ctx.beginPath();
                ctx.moveTo(-12, 0);
                ctx.lineTo(12, 0);
                ctx.stroke();
                ctx.restore();
            }
        }
        requestAnimationFrame(render);
    }
    render();
})();

